@Fin.val_add_one : ∀ {n : ℕ} (i : Fin (n + 1)), ↑(i + 1) = if i = Fin.last n then 0 else ↑i + 1
@Fin.val_add_one_of_lt : ∀ {n : ℕ} {i : Fin n.succ}, i < Fin.last n → ↑(i + 1) = ↑i + 1
Fin.val_natCast : ∀ (a n : ℕ) [inst : NeZero n], ↑↑a = a % n
@Fin.cast_val_eq_self : ∀ {n : ℕ} (a : Fin n), ↑↑a = a
@Function.update_comm : ∀ {α : Sort u_2} [inst : DecidableEq α] {β : α → Sort u_1} {a b : α},
  a ≠ b →
    ∀ (v : β a) (w : β b) (f : (a : α) → β a),
      Function.update (Function.update f a v) b w = Function.update (Function.update f b w) a v
@Function.update_idem : ∀ {α : Sort u_2} [inst : DecidableEq α] {β : α → Sort u_1} {a : α} (v w : β a)
  (f : (a : α) → β a), Function.update (Function.update f a v) a w = Function.update f a w
@Function.update_eq_self : ∀ {α : Sort u_1} {β : α → Sort u_2} [inst : DecidableEq α] (a : α) (f : (a : α) → β a),
  Function.update f a (f a) = f
@Finset.sum_range_sub : ∀ {G : Type u_1} [inst : AddCommGroup G] (f : ℕ → G) (n : ℕ),
  ∑ i ∈ Finset.range n, (f (i + 1) - f i) = f n - f 0
@AdalyFormal.CurvBlock.block_sum_shift : ∀ {L : AdalyFormal.Target.ClayStatement.PeriodicLatticeExtent} {β : Type u_1}
  [inst : AddCommMonoid β] (s ell n : ℕ) (μ : Fin 3) {y : AdalyFormal.Target.ClayStatement.PeriodicLatticeSite L},
  (∀ (ν : Fin 3), ↑(y ν) + s * ell ≤ L ν + 1) →
    (∀ (ν : Fin 3), ↑(AdalyFormal.Balaban.CoarseCurl.coarseShift y n μ ν) + s * ell ≤ L ν + 1) →
      ∀ (F : AdalyFormal.Target.ClayStatement.PeriodicLatticeSite L → β),
        ∑ x ∈ AdalyFormal.Balaban.QjComposite.stepBlockOf y s ell,
            F (AdalyFormal.Balaban.CoarseCurl.coarseShift x n μ) =
          ∑ x ∈ AdalyFormal.Balaban.QjComposite.stepBlockOf (AdalyFormal.Balaban.CoarseCurl.coarseShift y n μ) s ell,
            F x
@AdalyFormal.Balaban.QjComposite.card_stepBlockOf : ∀ {L : AdalyFormal.Target.ClayStatement.PeriodicLatticeExtent}
  (y : AdalyFormal.Target.ClayStatement.PeriodicLatticeSite L) (s ell : ℕ),
  0 < s →
    (∀ (μ : Fin 3), ↑(y μ) + s * ell ≤ L μ + 1) → (AdalyFormal.Balaban.QjComposite.stepBlockOf y s ell).card = ell ^ 3
@AdalyFormal.Balaban.QjComposite.stepBlockOf_one : ∀ {L : AdalyFormal.Target.ClayStatement.PeriodicLatticeExtent}
  (y : AdalyFormal.Target.ClayStatement.PeriodicLatticeSite L) (ell : ℕ),
  AdalyFormal.Balaban.QjComposite.stepBlockOf y 1 ell = AdalyFormal.Balaban.AdmissibleSubspace.blockOf y ell
@AdalyFormal.Balaban.QjComposite.stepAverage_trivialU : ∀ {L : AdalyFormal.Target.ClayStatement.PeriodicLatticeExtent}
  (s ell : ℕ)
  (lam : AdalyFormal.Target.ClayStatement.PeriodicLatticeSite L → ↥AdalyFormal.Balaban.CovariantOperators.SuTwo)
  (y : AdalyFormal.Target.ClayStatement.PeriodicLatticeSite L),
  AdalyFormal.Balaban.QjComposite.stepAverage s (AdalyFormal.Balaban.CovariantHjMinimizer.trivialU L) ell lam y =
    (1 / ↑ell ^ 3) • ∑ x ∈ AdalyFormal.Balaban.QjComposite.stepBlockOf y s ell, lam x
@AdalyFormal.W6.Qflat_row : ∀ {ell k : ℕ} {Lu : AdalyFormal.Target.ClayStatement.PeriodicLatticeExtent}
  {S : AdalyFormal.StatementLane.Tower (AdalyFormal.StatementLane.scaleUp ell k Lu)} (hell : 0 < ell)
  (A : AdalyFormal.Balaban.CovariantOperators.BondFnL2 (AdalyFormal.StatementLane.scaleUp ell k Lu))
  (p : AdalyFormal.IngredientFamilyR2.BIdx (AdalyFormal.IngredientFamilyR2.geomOf ell k S)),
  ((AdalyFormal.IngredientFamilyR2.bondSectorOf (AdalyFormal.IngredientFamilyR2.geomOf ell k S)
              (AdalyFormal.Balaban.CovariantHjMinimizer.trivialU (AdalyFormal.StatementLane.scaleUp ell k Lu))).Qfull
          A).ofLp
      p =
    AdalyFormal.Balaban.LineIntegralCovariant.lineCoarseRestrictSuTwo (ell ^ ↑p.fst) A.ofLp
      (AdalyFormal.W6.rowCB hell p)
@AdalyFormal.IngredientFamilyR2.not_OmGe_of_lt : ∀ {L : AdalyFormal.Target.ClayStatement.PeriodicLatticeExtent}
  {G : AdalyFormal.IngredientFamilyR2.TowerGeom L} {j : ℕ},
  G.k < j → ∀ (x : AdalyFormal.Target.ClayStatement.PeriodicLatticeSite L), ¬AdalyFormal.IngredientFamilyR2.OmGe G j x
@AdalyFormal.Balaban.QOne.pathSite_succ : ∀ {L : AdalyFormal.Target.ClayStatement.PeriodicLatticeExtent}
  (x : AdalyFormal.Target.ClayStatement.PeriodicLatticeSite L) (μ : Fin 3) (i : ℕ),
  AdalyFormal.Balaban.QOne.pathSite x μ (i + 1) =
    AdalyFormal.Target.ClayStatement.periodicLatticeShift (AdalyFormal.Balaban.QOne.pathSite x μ i) μ
@AdalyFormal.StatementLaneG.inner_DpiFull_flat : ∀ {L : AdalyFormal.Target.ClayStatement.PeriodicLatticeExtent}
  (G : AdalyFormal.IngredientFamilyR2.TowerGeom L) (a : ℝ) (A : AdalyFormal.Balaban.CovariantOperators.BondFnL2 L),
  inner ℝ A ((AdalyFormal.IngredientFamilyR2.DpiFull G AdalyFormal.IngredientFamilyR2.flatCfg a) A) =
    ‖(AdalyFormal.StatementLaneR6.plaqMask (AdalyFormal.IngredientFamilyR2.plaqIn G.Om0))
          ((AdalyFormal.Balaban.DeltaKFull.curlCovariantCLM_L2 AdalyFormal.IngredientFamilyR2.flatCfg) A)‖ ^
      2
@AdalyFormal.IngredientFamilyR2.inner_MassFull : ∀ {L : AdalyFormal.Target.ClayStatement.PeriodicLatticeExtent}
  (G : AdalyFormal.IngredientFamilyR2.TowerGeom L) (a : ℝ) (S : AdalyFormal.IngredientFamilyR2.BondSector G)
  (A : AdalyFormal.Balaban.CovariantOperators.BondFnL2 L),
  inner ℝ A ((AdalyFormal.IngredientFamilyR2.MassFull G a S) A) = ∑ p, a * ↑G.ell ^ ↑p.fst * ‖(S.Qfull A).ofLp p‖ ^ 2
@AdalyFormal.Balaban.DeltaKFull.curlCovariantCLM_L2_toLp : ∀
  {L : AdalyFormal.Target.ClayStatement.PeriodicLatticeExtent}
  (U : AdalyFormal.Target.ClayStatement.PeriodicLinkConfiguration (↥(Matrix.specialUnitaryGroup (Fin 2) ℂ)) L)
  (A : AdalyFormal.Balaban.AdmissibleSubspace.Bond L → ↥AdalyFormal.Balaban.CovariantOperators.SuTwo),
  (AdalyFormal.Balaban.DeltaKFull.curlCovariantCLM_L2 U) (WithLp.toLp 2 A) =
    WithLp.toLp 2 (AdalyFormal.Balaban.CovariantOperators.curlValueCovariant U A)
