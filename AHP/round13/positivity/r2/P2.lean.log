 Classical.choice,
 Quot.sound]
@AdalyFormal.Round13.Positivity.Physical.rightStar_P2 : ∀ {q R : ℕ} (hq : 0 < q),
  2 ∣ R →
    18 ≤ R →
      ∀ (t : ℝ),
        0 < t →
          t < Real.pi / 2 →
            ∀ (x : AdalyFormal.Round9.Guarded.AnalyticR1.TwistSpace q R),
              x ≠ 0 →
                (AdalyFormal.Round12.Kernel.Actual.chargedCoordinate q R
                        (AdalyFormal.Round5.Guarded.IVTR2.rightSite hq R, 0))
                      x =
                    0 →
                  0 <
                    inner ℝ x
                      ((AdalyFormal.Round9.Guarded.Qualitative.vacA q R
                          (AdalyFormal.Round12.Noncancel.RightFamily.rightStar hq R) 1 t)
                        x)
AdalyFormal.Round13.Positivity.Physical.cofinal_rightStar_P2 : ∀ (j₀ : ℕ),
  ∃ j,
    j₀ ≤ j ∧
      ∀ (R₀ : ℕ),
        ∃ R,
          R₀ ≤ R ∧
            2 ∣ R ∧
              18 ≤ R ∧
                ∀ (t : ℝ),
                  0 < t →
                    t < Real.pi / 2 →
                      ∀ (x : AdalyFormal.Round9.Guarded.AnalyticR1.TwistSpace (2 ^ j) R),
                        x ≠ 0 →
                          (AdalyFormal.Round12.Kernel.Actual.chargedCoordinate (2 ^ j) R
                                  (AdalyFormal.Round5.Guarded.IVTR2.rightSite ⋯ R, 0))
                                x =
                              0 →
                            0 <
                              inner ℝ x
                                ((AdalyFormal.Round9.Guarded.Qualitative.vacA (2 ^ j) R
                                    (AdalyFormal.Round12.Noncancel.RightFamily.rightStar ⋯ R) 1 t)
                                  x)
