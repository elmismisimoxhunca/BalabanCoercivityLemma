@weightedRightStar_negative_pi : ∀ {q R : ℕ} (hq : 0 < q),
  2 ∣ R →
    18 ≤ R →
      ∀ (c : Bond (scaleUp 2 1 (dilLu q R)) → ℝ),
        (∀ e ∈ starLinks (periodicLatticeShift (rightSite hq R) 0), c e = 1 ∨ c e = -1) →
          ∃ w, ⟪w, (vacA q R (weightedRightStar hq R c) 1 Real.pi) w⟫ < 0
