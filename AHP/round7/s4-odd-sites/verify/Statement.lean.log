AdalyFormal.SitesOnly.main_neg_S [CfData] {ell M R c : ℕ} (hell3 : 3 ≤ ell) (hE : 2 ∣ ell) (hdvd : ell ∣ M)
  (hMe2 : ell * ell ≤ M) (hR : 1 ≤ R) (hrel : SitesOnly.SoRel ell c) (hc : 10 ≤ c) {a : ℝ} (ha : 0 < a)
  (hinj :
    ∀ (y : IngredientFamilyR2.FSp (IngredientFamilyR2.geomOf ell 2 (CoverNested.neS ell M R))),
      (NcwdhTwo.Pt ell M R ⋯ (SitesOnly.soC ell M R c) 0 a).data.Qs y = 0 → y = 0)
  (h0 : CoverOmega.UnitsFour (NcwdhTwo.Pt ell M R ⋯ (SitesOnly.soC ell M R c) 0 a)) :
  ∃ uE,
    uE % ell + 2 ≤ ell ∧
      CoverNested.neLo M R ≤ uE ∧
        uE + 1 < CoverNested.neLo M R + M ∧
          ∃ t,
            |t| < Real.pi / 2 ∧
              GenP.WellDefG (NcwdhTwo.Pt ell M R ⋯ (SitesOnly.soC ell M R c) t a) ∧
                GenP.genForm (NcwdhTwo.Pt ell M R ⋯ (SitesOnly.soC ell M R c) t a)
                    (WithLp.toLp 2
                      ((GenP.genC (NcwdhTwo.Pt ell M R ⋯ (SitesOnly.soC ell M R c) t a)) (SitesOnly.Bpatf ell uE))) <
                  0
