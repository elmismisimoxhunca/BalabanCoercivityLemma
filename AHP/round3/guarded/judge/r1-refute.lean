/-!
Round-3 negative attempt: a narrow top strip admits no positive-energy
competitor under the actual Lambda collar. This excludes the new numerical
probe from the negative certificate even when its base geometry is repaired.
Neither negative goal is asserted.
-/
namespace AdalyFormal.Round3.Guarded.RefuteR1

open scoped RealInnerProductSpace
open AdalyFormal.Target.ClayStatement
open AdalyFormal.StatementLane
open AdalyFormal.StatementLane2
open AdalyFormal.StatementLaneG
open AdalyFormal.IngredientFamilyR2
open AdalyFormal.Round2.Guarded.Pin
open AdalyFormal.Balaban.CovariantOperators (SuTwo BondFnL2)
open AdalyFormal.Balaban.AdmissibleSubspace (Bond)
open AdalyFormal.Balaban.CoercUMainDesigned (LinkCfg)
open AdalyFormal.Balaban.RegularUPerturbation (bondEnergy)

/-- Replacing only coordinate zero gives this exact upper distance bound. -/
theorem pdist_update_zero_le {L : PeriodicLatticeExtent}
    (y : PeriodicLatticeSite L) (q : Fin (L 0 + 1)) (hy : (y 0).val ≤ q.val) :
    pdist y (Function.update y 0 q) ≤ q.val - (y 0).val := by
  simp only [pdist, Fin.sum_univ_three, Function.update_self,
    Function.update_of_ne (by decide : (1 : Fin 3) ≠ 0),
    Function.update_of_ne (by decide : (2 : Fin 3) ≠ 0)]
  simp only [pcd, if_pos hy, le_refl, ite_true, Nat.sub_self, zero_min, add_zero]
  exact min_le_left _ _

/-- No room for Lambda if every embedded top site has an exterior site
within the required collar. This uses the actual LambdaOK, not a repair. -/
theorem lambda_empty_of_escape {Lu Lf : PeriodicLatticeExtent}
    {ell M R k : ℕ} {S : Tower Lf} {Lam : Set (PeriodicLatticeSite Lu)}
    (hL : LambdaOK ell M R k S Lam)
    (hesc : ∀ emb : PeriodicLatticeSite Lu → PeriodicLatticeSite Lf,
      (∀ y μ, (emb y μ).val = (ell ^ k) * (y μ).val) →
      ∀ y, emb y ∈ S.Om k →
        ∃ z, emb z ∉ S.Om k ∧ pdist y z ≤ R * M) :
    Lam = ∅ := by
  obtain ⟨_, emb, hemb, hsub, hcollar⟩ := hL
  apply Set.eq_empty_iff_forall_notMem.mpr
  intro y hy
  obtain ⟨z, hz, hd⟩ := hesc emb hemb y (hsub y hy)
  exact (not_lt_of_ge hd) (hcollar y hy z hz)

/-- A top strip no wider than RM in unit coordinates leaves no compatible
Lambda. All other coordinates and every lower domain are unrestricted. -/
theorem lambda_empty_of_thin_top {Lu Lf : PeriodicLatticeExtent}
    {ell M R k p q : ℕ} {S : Tower Lf} {Lam : Set (PeriodicLatticeSite Lu)}
    (hscale : 0 < ell ^ k) (hq : q < Lu 0 + 1) (hwidth : q - p ≤ R * M)
    (htop : ∀ x : PeriodicLatticeSite Lf,
      x ∈ S.Om k ↔ ell ^ k * p ≤ (x 0).val ∧ (x 0).val < ell ^ k * q)
    (hL : LambdaOK ell M R k S Lam) : Lam = ∅ := by
  apply lambda_empty_of_escape hL
  intro emb hemb y hy
  have hxy := (htop (emb y)).mp hy
  rw [hemb y 0] at hxy
  have hyp : p ≤ (y 0).val := Nat.le_of_mul_le_mul_left hxy.1 hscale
  have hyq : (y 0).val < q := Nat.lt_of_mul_lt_mul_left hxy.2
  let z : PeriodicLatticeSite Lu := Function.update y 0 ⟨q, hq⟩
  refine ⟨z, ?_, ?_⟩
  · intro hz
    have hbad := ((htop (emb z)).mp hz).2
    rw [hemb z 0] at hbad
    change ell ^ k * q < ell ^ k * q at hbad
    exact (lt_irrefl _) hbad
  · have hd := pdist_update_zero_le y (⟨q, hq⟩ : Fin (Lu 0 + 1))
      (show (y 0).val ≤ q from Nat.le_of_lt hyq)
    change pdist y z ≤ q - (y 0).val at hd
    exact le_trans hd (by omega)

/-- Lifted torus of collar_probe.py at R=2,6,18: fine sides (4R+16,8,8). -/
def probeLu (R : ℕ) : PeriodicLatticeExtent :=
  fun μ => if μ = 0 then 2 * R + 7 else 3

def probeTower (R : ℕ) : Tower (scaleUp 2 1 (probeLu R)) where
  Om j := if j = 0 then {x | 4 ≤ (x 0).val ∧ (x 0).val < 4 * R + 8}
    else if j = 1 then {x | 2 * R + 4 ≤ (x 0).val ∧ (x 0).val < 2 * R + 8}
    else ∅

theorem probe_torus (R : ℕ) : TorusOK 2 2 (probeLu R) := by
  refine ⟨?_, ?_, ?_⟩
  · intro μ
    by_cases h : μ = 0 <;> simp [probeLu, h]
  · intro μ
    by_cases h : μ = 0 <;> simp [probeLu, h]
  · intro μ
    by_cases h : μ = 0 <;> simp [probeLu, h]

theorem probe_lambda_empty {R : ℕ} (hR : 1 ≤ R)
    (Lam : Set (PeriodicLatticeSite (probeLu R)))
    (hL : LambdaOK2 2 2 R 1 (probeTower R) Lam) : Lam = ∅ := by
  apply lambda_empty_of_thin_top (p := R + 2) (q := R + 4)
    (by norm_num) (by simp [probeLu]; omega) (by omega) _ hL.1
  intro x
  change (2 * R + 4 ≤ (x 0).val ∧ (x 0).val < 2 * R + 8) ↔
    (2 * (R + 2) ≤ (x 0).val ∧ (x 0).val < 2 * (R + 4))
  omega

/-- Every compatible competitor on the numerical family has zero energy,
independently of U, inverse values, smallness and the observed spectral roots. -/
theorem probe_energy_zero {R : ℕ} (hR : 1 ≤ R)
    (Lam : Set (PeriodicLatticeSite (probeLu R)))
    (hL : LambdaOK2 2 2 R 1 (probeTower R) Lam)
    (Bt : Bond (probeLu R) → SuTwo) (hBt : OnLambdaT Lam Bt) :
    bondEnergy Bt = 0 := by
  have he := probe_lambda_empty hR Lam hL
  have hz : Bt = 0 := by
    funext b
    apply hBt b
    simp [he]
  rw [hz]
  unfold bondEnergy
  exact Finset.sum_eq_zero (fun b _ => by simp)

/-- Main compiled partial: this new numerical family cannot be used in the
pinned cofinal certificate, regardless of any future exact spectral proof. -/
theorem probe_not_negative_witness {R : ℕ} (hR : 1 ≤ R) :
    ¬ ∃ (Lam : Set (PeriodicLatticeSite (probeLu R)))
      (_ : LambdaOK2 2 2 R 1 (probeTower R) Lam)
      (Bt : Bond (probeLu R) → SuTwo),
      OnLambdaTildeIn Lam 2 Bt ∧ OnLambdaT Lam Bt ∧ 0 < bondEnergy Bt := by
  rintro ⟨Lam, hL, Bt, _, hBt, hpos⟩
  rw [probe_energy_zero hR Lam hL Bt hBt] at hpos
  exact (lt_irrefl _) hpos

/-- The inequality itself is trivial on the new probes under LambdaOK2;
this is an instance exclusion, not either positive headline. -/
theorem probe_instIneq {R : ℕ} (hR : 1 ≤ R)
    (Lam : Set (PeriodicLatticeSite (probeLu R)))
    (hL : LambdaOK2 2 2 R 1 (probeTower R) Lam)
    (a γ : ℝ) (U : LinkCfg (scaleUp 2 1 (probeLu R))) :
    InstIneqS selAll selAll 2 1 (by omega) a (probeLu R) γ (probeTower R) Lam U := by
  apply AdalyFormal.D1Guarded.InstIneqS_of_no_testfield
  rintro ⟨Bt, h1, h2, h3⟩
  exact probe_not_negative_witness hR ⟨Lam, hL, Bt, h1, h2, h3⟩

