import CG6e
import CG6d

/-!
# MX_CG -- the covering lemmas `box_core`, `cellbox_core`, `cellbox_wrap` of the cover_geom lane for the MIXED class (lane mixed_20261017)

Text copies (generated by tools/gen_cg.py) of `CG1.box_core`, `CG3.cellbox_core`, `CG6e.cellbox_wrap` with `CoversOm0p ell M c` / `IsClassCube ell M c` replaced by
`CoversOmΦ ell M Φ` / `IsClassCubeΦ ell M Φ`.  The argument is factor-free: the plaquette at the corner lies in one cube (some factor in Φ), which is block-closed at
scale `W` (`classCube_sat`) and therefore contains the whole `W`-cells.
-/
set_option autoImplicit false
set_option maxHeartbeats 8000000
set_option linter.unusedVariables false

namespace MXP.CoverGeom

open AdalyFormal.Target.ClayStatement AdalyFormal.StatementLane AdalyFormal.StatementLane2
open AdalyFormal.CoverGeom
open MXP.AllC

variable {L : PeriodicLatticeExtent}

theorem box_coreΦ {ell M R k j : ℕ} {Φ : Set ℕ} {S : Tower L} (W : ℕ) (hW : 0 < W)
    (hWpred : W ∣ bigSide M ell (j - 1)) (hWidx : ∀ i, j ≤ i + 2 → W ∣ bigSide M ell i) (hjk : j - 1 ≤ k)
    (hadm : Admissible ell M R k S) (hcov : CoversOmΦ ell M Φ k S)
    (μ ν ρ : Fin 3) (hμν : μ < ν) (hρμ : ρ ≠ μ) (hρν : ρ ≠ ν)
    (hall : ∀ τ : Fin 3, τ = μ ∨ τ = ν ∨ τ = ρ)
    (lo hi : Fin 3 → ℕ) (hle : ∀ τ, lo τ ≤ hi τ) (hhi : ∀ τ, hi τ < L τ + 1)
    (hone : ∀ τ, hi τ / W ≤ lo τ / W + 1)
    (hfree : hi ρ / W = lo ρ / W)
    (hwide : ∀ τ, τ ≠ ρ → hi τ / W ≠ lo τ / W ∨ lo τ < hi τ)
    (hΩ : ∀ p : PeriodicLatticeSite L, (∀ τ, lo τ ≤ (p τ).val ∧ (p τ).val ≤ hi τ) →
      ∃ x ∈ S.Om (j - 1), ∀ τ, (p τ).val / W = (x τ).val / W) :
    ∃ (sites : Set (PeriodicLatticeSite L)) (i : ℕ), IsClassCubeΦ ell M Φ k S sites i ∧ j ≤ i + 2 ∧
      ∀ p : PeriodicLatticeSite L, (∀ τ, lo τ ≤ (p τ).val ∧ (p τ).val ≤ hi τ) → p ∈ sites := by
  have hμν' : μ ≠ ν := ne_of_lt hμν
  have hmono := hadm.1
  have hanti : Antitone S.Om := antitone_nat_of_succ_le hmono
  -- base coordinates
  let yv : Fin 3 → ℕ := fun τ => if hi τ / W = lo τ / W then lo τ else (hi τ / W) * W - 1
  have hcr : ∀ τ, hi τ / W ≠ lo τ / W → hi τ / W = lo τ / W + 1 := by
    intro τ h
    have h1 := hone τ
    have h2 : lo τ / W ≤ hi τ / W := Nat.div_le_div_right (hle τ)
    omega
  have hyv_cell : ∀ τ, yv τ / W = lo τ / W := by
    intro τ
    by_cases h : hi τ / W = lo τ / W
    · simp [yv, h]
    · have hq := hcr τ h
      have hz0 := Nat.zero_le (lo τ / W)
      simp only [yv, h, if_false]
      rw [(cross_cells hW (by omega : 1 ≤ hi τ / W)).1]; omega
  have hyv_lo : ∀ τ, lo τ ≤ yv τ := by
    intro τ
    by_cases h : hi τ / W = lo τ / W
    · simp [yv, h]
    · have hq := hcr τ h
      simp only [yv, h, if_false]
      have h1 : lo τ < W * (lo τ / W) + W := by
        have := Nat.mod_lt (lo τ) hW
        have := Nat.div_add_mod (lo τ) W
        omega
      rw [hq]
      have : (lo τ / W + 1) * W = W * (lo τ / W) + W := by ring
      omega
  have hyv_hi : ∀ τ, yv τ ≤ hi τ := by
    intro τ
    by_cases h : hi τ / W = lo τ / W
    · simp only [yv, h, if_true]; exact hle τ
    · simp only [yv, h, if_false]
      have := Nat.div_mul_le_self (hi τ) W
      omega
  have hyv_hi1 : ∀ τ, τ ≠ ρ → yv τ + 1 ≤ hi τ := by
    intro τ hτ
    by_cases h : hi τ / W = lo τ / W
    · have : lo τ < hi τ := by
        rcases hwide τ hτ with h' | h'
        · exact absurd h h'
        · exact h'
      simp only [yv, h, if_true]; omega
    · simp only [yv, h, if_false]
      have hq := hcr τ h
      have hz0 := Nat.zero_le (lo τ / W)
      have := Nat.div_mul_le_self (hi τ) W
      have h1 : 1 ≤ (hi τ / W) * W := Nat.mul_pos (by omega) hW
      omega
  have hyv_pc : ∀ τ pv, lo τ ≤ pv → pv ≤ hi τ → pv / W = yv τ / W ∨ pv / W = (yv τ + 1) / W := by
    intro τ pv h1 h2
    have a1 : lo τ / W ≤ pv / W := Nat.div_le_div_right h1
    have a2 : pv / W ≤ hi τ / W := Nat.div_le_div_right h2
    by_cases h : hi τ / W = lo τ / W
    · left; rw [hyv_cell]; omega
    · have hq := hcr τ h
      by_cases h3 : pv / W = lo τ / W
      · left; rw [hyv_cell]; exact h3
      · right
        have hz0 := Nat.zero_le (lo τ / W)
        have e : (yv τ + 1) / W = hi τ / W := by
          simp only [yv, h, if_false]
          exact (cross_cells hW (by omega : 1 ≤ hi τ / W)).2
        rw [e]; omega
  have hlt : ∀ τ, yv τ < L τ + 1 := fun τ => by have := hyv_hi τ; have := hhi τ; omega
  let ysite : PeriodicLatticeSite L := fun τ => ⟨yv τ, hlt τ⟩
  have hy1 : ∀ τ, (ysite τ).val = yv τ := fun τ => rfl
  let s1 := periodicLatticeShift ysite μ
  let s2 := periodicLatticeShift ysite ν
  let s3 := periodicLatticeShift s1 ν
  let s3' := periodicLatticeShift s2 μ
  have hs1 : ∀ τ, (s1 τ).val = if τ = μ then yv μ + 1 else yv τ := by
    intro τ
    exact shift_val μ τ (by have := hyv_hi1 μ hρμ.symm; have := hhi μ; simp [hy1]; omega)
  have hs2 : ∀ τ, (s2 τ).val = if τ = ν then yv ν + 1 else yv τ := by
    intro τ
    exact shift_val ν τ (by have := hyv_hi1 ν hρν.symm; have := hhi ν; simp [hy1]; omega)
  have hs3 : ∀ τ, (s3 τ).val = if τ = ν then yv ν + 1 else (if τ = μ then yv μ + 1 else yv τ) := by
    intro τ
    have : (s1 ν).val + 1 < L ν + 1 := by
      rw [hs1 ν]; simp [hμν'.symm]; have := hyv_hi1 ν hρν.symm; have := hhi ν; omega
    rw [shift_val ν τ this, hs1 ν, hs1 τ]
    simp [hμν'.symm]
  have hs3' : ∀ τ, (s3' τ).val = if τ = μ then yv μ + 1 else (if τ = ν then yv ν + 1 else yv τ) := by
    intro τ
    have : (s2 μ).val + 1 < L μ + 1 := by
      rw [hs2 μ]; simp [hμν']; have := hyv_hi1 μ hρμ.symm; have := hhi μ; omega
    rw [shift_val μ τ this, hs2 μ, hs2 τ]
    simp [hμν']
  -- all vertices lie in the box, hence in Ω_{j-1}
  have hmem : ∀ v : PeriodicLatticeSite L, (∀ τ, lo τ ≤ (v τ).val ∧ (v τ).val ≤ hi τ) →
      v ∈ S.Om (j - 1) := by
    intro v hv
    obtain ⟨x, hx, hxv⟩ := hΩ v hv
    exact om_cell_closed hadm hjk hW hWpred hx (fun τ => (hxv τ).symm)
  have hb1 : ∀ τ, τ ≠ ρ → yv τ + 1 ≤ hi τ := hyv_hi1
  have hy_in : ysite ∈ S.Om (j - 1) :=
    hmem _ (fun τ => by rw [hy1]; exact ⟨hyv_lo τ, hyv_hi τ⟩)
  have hs1_in : s1 ∈ S.Om (j - 1) := hmem _ (fun τ => by
    rw [hs1]; split_ifs with h
    · subst h; exact ⟨by have := hyv_lo τ; omega, hb1 τ hρμ.symm⟩
    · exact ⟨hyv_lo τ, hyv_hi τ⟩)
  have hs2_in : s2 ∈ S.Om (j - 1) := hmem _ (fun τ => by
    rw [hs2]; split_ifs with h
    · subst h; exact ⟨by have := hyv_lo τ; omega, hb1 τ hρν.symm⟩
    · exact ⟨hyv_lo τ, hyv_hi τ⟩)
  have hs3_in : s3 ∈ S.Om (j - 1) := hmem _ (fun τ => by
    rw [hs3]; split_ifs with h h'
    · subst h; exact ⟨by have := hyv_lo τ; omega, hb1 τ hρν.symm⟩
    · subst h'; exact ⟨by have := hyv_lo τ; omega, hb1 τ hρμ.symm⟩
    · exact ⟨hyv_lo τ, hyv_hi τ⟩)
  have hs3'_in : s3' ∈ S.Om (j - 1) := hmem _ (fun τ => by
    rw [hs3']; split_ifs with h h'
    · subst h; exact ⟨by have := hyv_lo τ; omega, hb1 τ hρμ.symm⟩
    · subst h'; exact ⟨by have := hyv_lo τ; omega, hb1 τ hρν.symm⟩
    · exact ⟨hyv_lo τ, hyv_hi τ⟩)
  have h0 : ∀ v, v ∈ S.Om (j - 1) → v ∈ S.Om 0 := fun v hv => hanti (Nat.zero_le _) hv
  let pl : PeriodicLatticePlaquette L := (ysite, ⟨(μ, ν), hμν⟩)
  have hp : ∀ e ∈ periodicPlaquetteBoundaryEdges pl, CubeBond (S.Om 0) e := by
    intro e he
    simp only [periodicPlaquetteBoundaryEdges, pl, Finset.mem_insert, Finset.mem_singleton] at he
    rcases he with rfl | rfl | rfl | rfl
    · exact ⟨h0 _ hy_in, h0 _ hs1_in⟩
    · exact ⟨h0 _ hs1_in, h0 _ hs3_in⟩
    · exact ⟨h0 _ hs2_in, h0 _ hs3'_in⟩
    · exact ⟨h0 _ hy_in, h0 _ hs2_in⟩
  obtain ⟨sites, i, hclΦ, hb⟩ := hcov.2 pl hp
  obtain ⟨fΦ, hfΦ, hcl⟩ := id hclΦ
  have hbm : ∀ e ∈ periodicPlaquetteBoundaryEdges pl, CubeBond sites e := hb
  have b1 := hbm (ysite, μ) (by simp [periodicPlaquetteBoundaryEdges, pl])
  have b2 := hbm (s1, ν) (by simp [periodicPlaquetteBoundaryEdges, pl, s1])
  have b3 := hbm (s2, μ) (by simp [periodicPlaquetteBoundaryEdges, pl, s2])
  have hy_s : ysite ∈ sites := b1.1
  have hs1_s : s1 ∈ sites := b1.2
  have hs3_s : s3 ∈ sites := b2.2
  have hs2_s : s2 ∈ sites := b3.1
  have hidx : j ≤ i + 2 := classCube_index_ge hmono hcl hy_s hy_in
  refine ⟨sites, i, hclΦ, hidx, ?_⟩
  intro p hp'
  have hWi : W ∣ bigSide M ell i := hWidx i hidx
  have key : ∀ v, v ∈ sites → (∀ τ, (p τ).val / W = (v τ).val / W) → p ∈ sites :=
    fun v hv hc => classCube_sat hadm hcl hW hWi hv (fun τ => (hc τ).symm)
  have hρc : (p ρ).val / W = yv ρ / W := by
    rw [hyv_cell]
    have a1 : lo ρ / W ≤ (p ρ).val / W := Nat.div_le_div_right (hp' ρ).1
    have a2 : (p ρ).val / W ≤ hi ρ / W := Nat.div_le_div_right (hp' ρ).2
    omega
  have cpμ := hyv_pc μ _ (hp' μ).1 (hp' μ).2
  have cpν := hyv_pc ν _ (hp' ν).1 (hp' ν).2
  rcases cpμ with hμ0 | hμ1 <;> rcases cpν with hν0 | hν1
  · refine key ysite hy_s (fun τ => ?_)
    rcases hall τ with rfl | rfl | rfl
    · rw [hy1]; exact hμ0
    · rw [hy1]; exact hν0
    · rw [hy1]; exact hρc
  · refine key s2 hs2_s (fun τ => ?_)
    rcases hall τ with rfl | rfl | rfl
    · rw [hs2]; simp [hμν']; exact hμ0
    · rw [hs2]; simp; exact hν1
    · rw [hs2]; simp [hρν]; exact hρc
  · refine key s1 hs1_s (fun τ => ?_)
    rcases hall τ with rfl | rfl | rfl
    · rw [hs1]; simp; exact hμ1
    · rw [hs1]; simp [hμν'.symm]; exact hν0
    · rw [hs1]; simp [hρμ]; exact hρc
  · refine key s3 hs3_s (fun τ => ?_)
    rcases hall τ with rfl | rfl | rfl
    · rw [hs3]; simp [hμν']; exact hμ1
    · rw [hs3]; simp; exact hν1
    · rw [hs3]; simp [hρν, hρμ]; exact hρc

theorem cellbox_coreΦ {ell M R k : ℕ} {Φ : Set ℕ} {S : Tower L} (s : ℕ) (hs : 2 ≤ s)
    (hadm : Admissible ell M R k S) (hcov : CoversOmΦ ell M Φ k S)
    (n u : Fin 3 → ℕ) (hn : ∀ τ, L τ + 1 = s * n τ) (hu : ∀ τ, u τ < n τ)
    (two : Fin 3 → Prop) [DecidablePred two]
    (μ ν ρ : Fin 3) (hμν : μ < ν) (hρμ : ρ ≠ μ) (hρν : ρ ≠ ν) (hall : ∀ τ : Fin 3, τ = μ ∨ τ = ν ∨ τ = ρ)
    (hρ1 : ¬ two ρ)
    {Om : Set (PeriodicLatticeSite L)} (hOm0 : Om ⊆ S.Om 0)
    (hΩ : ∀ x ∈ CellReg s n u two, x ∈ Om)
    (hWidx : ∀ (sites : Set (PeriodicLatticeSite L)) (i : ℕ), IsClassCubeΦ ell M Φ k S sites i →
      (∃ y ∈ sites, y ∈ CellReg s n u two) → s ∣ bigSide M ell i) :
    ∃ (sites : Set (PeriodicLatticeSite L)) (i : ℕ), IsClassCubeΦ ell M Φ k S sites i ∧
      CellReg s n u two ⊆ sites := by
  have hs0 : 0 < s := by omega
  have hμν' : μ ≠ ν := ne_of_lt hμν
  have hsn : ∀ τ, s * u τ + s ≤ L τ + 1 := fun τ => by
    have h2 : s * (u τ + 1) ≤ s * n τ := Nat.mul_le_mul_left _ (hu τ)
    have h3 : s * (u τ + 1) = s * u τ + s := by ring
    have := hn τ; omega
  let yv : Fin 3 → ℕ := fun τ => if two τ then s * u τ + s - 1 else s * u τ
  have hyv_lt : ∀ τ, yv τ < L τ + 1 := by
    intro τ; have := hsn τ; simp only [yv]; split_ifs <;> omega
  let ysite : PeriodicLatticeSite L := fun τ => ⟨yv τ, hyv_lt τ⟩
  have hy1 : ∀ τ, (ysite τ).val = yv τ := fun τ => rfl
  let s1 := periodicLatticeShift ysite μ
  let s2 := periodicLatticeShift ysite ν
  let s3 := periodicLatticeShift s1 ν
  let s3' := periodicLatticeShift s2 μ
  -- cell of the base coordinate and of its successor
  have hycell : ∀ τ, yv τ / s = u τ := by
    intro τ; simp only [yv]; split_ifs
    · have : s * u τ + s - 1 = s * u τ + (s - 1) := by omega
      rw [this]; exact cell_add hs0 _ _ (by omega)
    · have := cell_add hs0 (u τ) 0 hs0; simpa using this
  let wc : Fin 3 → ℕ := fun τ => if two τ then (u τ + 1) % n τ else u τ
  have hwcell : ∀ τ, ((yv τ + 1) % (L τ + 1)) / s = wc τ := by
    intro τ
    have := hsn τ
    simp only [yv, wc]; split_ifs with h
    · have h1 : s * u τ + s - 1 + 1 = s * (u τ + 1) + 0 := by ring_nf; omega
      rw [h1, hn τ, cell_mod hs0]
      simp [Nat.mul_div_cancel_left _ hs0]
    · rw [Nat.mod_eq_of_lt (by omega)]
      rw [show s * u τ + 1 = s * u τ + 1 from rfl]
      exact cell_add hs0 _ _ (by omega)
  have hs1v : ∀ τ, (s1 τ).val = if τ = μ then (yv μ + 1) % (L μ + 1) else yv τ := by
    intro τ; rw [shift_val']
  have hs2v : ∀ τ, (s2 τ).val = if τ = ν then (yv ν + 1) % (L ν + 1) else yv τ := by
    intro τ; rw [shift_val']
  have hs3v : ∀ τ, (s3 τ).val = if τ = ν then (yv ν + 1) % (L ν + 1) else if τ = μ then (yv μ + 1) % (L μ + 1) else yv τ := by
    intro τ; rw [shift_val']
    by_cases h : τ = ν
    · subst h; simp [hs1v, hμν'.symm]
    · simp [h, hs1v]
  have hs3'v : ∀ τ, (s3' τ).val = if τ = μ then (yv μ + 1) % (L μ + 1) else if τ = ν then (yv ν + 1) % (L ν + 1) else yv τ := by
    intro τ; rw [shift_val']
    by_cases h : τ = μ
    · subst h; simp [hs2v, hμν']
    · simp [h, hs2v]
  have hv0 : ∀ τ, (ysite τ).val / s = u τ := fun τ => by rw [hy1]; exact hycell τ
  have hv1 : ∀ τ, (s1 τ).val / s = if τ = μ then wc μ else u τ := by
    intro τ; rw [hs1v]; by_cases h : τ = μ
    · subst h; simp [hwcell]
    · simp [h, hycell]
  have hv2 : ∀ τ, (s2 τ).val / s = if τ = ν then wc ν else u τ := by
    intro τ; rw [hs2v]; by_cases h : τ = ν
    · subst h; simp [hwcell]
    · simp [h, hycell]
  have hv3 : ∀ τ, (s3 τ).val / s = if τ = ν then wc ν else if τ = μ then wc μ else u τ := by
    intro τ; rw [hs3v]; by_cases h : τ = ν
    · subst h; simp [hwcell]
    · by_cases h' : τ = μ
      · subst h'; simp [h, hwcell]
      · simp [h, h', hycell]
  have hv3' : ∀ τ, (s3' τ).val / s = if τ = μ then wc μ else if τ = ν then wc ν else u τ := by
    intro τ; rw [hs3'v]; by_cases h : τ = μ
    · subst h; simp [hwcell]
    · by_cases h' : τ = ν
      · subst h'; simp [h, hwcell]
      · simp [h, h', hycell]
  -- the vertices lie in the region
  have hwc_ok : ∀ τ, wc τ = u τ ∨ (two τ ∧ wc τ = (u τ + 1) % n τ) := by
    intro τ; simp only [wc]; split_ifs with h
    · exact Or.inr ⟨h, rfl⟩
    · exact Or.inl rfl
  have hreg : ∀ v : PeriodicLatticeSite L, (∀ τ, (v τ).val / s = u τ ∨ (v τ).val / s = wc τ) → v ∈ CellReg s n u two := by
    intro v hv τ
    rcases hv τ with h | h
    · exact Or.inl h
    · rw [h]; exact hwc_ok τ
  have hy_reg : ysite ∈ CellReg s n u two := hreg _ (fun τ => Or.inl (hv0 τ))
  have hs1_reg : s1 ∈ CellReg s n u two := hreg _ (fun τ => by rw [hv1]; split_ifs <;> first | exact Or.inl rfl | (subst_vars; exact Or.inr rfl))
  have hs2_reg : s2 ∈ CellReg s n u two := hreg _ (fun τ => by rw [hv2]; split_ifs <;> first | exact Or.inl rfl | (subst_vars; exact Or.inr rfl))
  have hs3_reg : s3 ∈ CellReg s n u two := hreg _ (fun τ => by rw [hv3]; split_ifs <;> first | exact Or.inl rfl | (subst_vars; exact Or.inr rfl))
  have hs3'_reg : s3' ∈ CellReg s n u two := hreg _ (fun τ => by rw [hv3']; split_ifs <;> first | exact Or.inl rfl | (subst_vars; exact Or.inr rfl))
  let pl : PeriodicLatticePlaquette L := (ysite, ⟨(μ, ν), hμν⟩)
  have hp : ∀ e ∈ periodicPlaquetteBoundaryEdges pl, CubeBond (S.Om 0) e := by
    intro e he
    simp only [periodicPlaquetteBoundaryEdges, pl, Finset.mem_insert, Finset.mem_singleton] at he
    rcases he with rfl | rfl | rfl | rfl
    · exact ⟨hOm0 (hΩ _ hy_reg), hOm0 (hΩ _ hs1_reg)⟩
    · exact ⟨hOm0 (hΩ _ hs1_reg), hOm0 (hΩ _ hs3_reg)⟩
    · exact ⟨hOm0 (hΩ _ hs2_reg), hOm0 (hΩ _ hs3'_reg)⟩
    · exact ⟨hOm0 (hΩ _ hy_reg), hOm0 (hΩ _ hs2_reg)⟩
  obtain ⟨sites, i, hclΦ, hb⟩ := hcov.2 pl hp
  obtain ⟨fΦ, hfΦ, hcl⟩ := id hclΦ
  have hbm : ∀ e ∈ periodicPlaquetteBoundaryEdges pl, CubeBond sites e := hb
  have b1 := hbm (ysite, μ) (by simp [periodicPlaquetteBoundaryEdges, pl])
  have b2 := hbm (s1, ν) (by simp [periodicPlaquetteBoundaryEdges, pl, s1])
  have b3 := hbm (s2, μ) (by simp [periodicPlaquetteBoundaryEdges, pl, s2])
  have hy_s : ysite ∈ sites := b1.1
  have hs1_s : s1 ∈ sites := b1.2
  have hs3_s : s3 ∈ sites := b2.2
  have hs2_s : s2 ∈ sites := b3.1
  refine ⟨sites, i, hclΦ, ?_⟩
  have hWi : s ∣ bigSide M ell i := hWidx sites i hclΦ ⟨ysite, hy_s, hy_reg⟩
  have key : ∀ (v : PeriodicLatticeSite L) (x : PeriodicLatticeSite L), v ∈ sites →
      (∀ τ, (x τ).val / s = (v τ).val / s) → x ∈ sites :=
    fun v x hv hc => classCube_sat hadm hcl hs0 hWi hv (fun τ => (hc τ).symm)
  intro x hx
  have hxμ := hx μ
  have hxν := hx ν
  have hxρ : (x ρ).val / s = u ρ := by
    rcases hx ρ with h | ⟨h, -⟩
    · exact h
    · exact absurd h hρ1
  -- choose the vertex
  by_cases hA : (x μ).val / s = u μ <;> by_cases hB : (x ν).val / s = u ν
  · refine key ysite x hy_s (fun τ => ?_)
    rcases hall τ with rfl | rfl | rfl
    · rw [hv0]; exact hA
    · rw [hv0]; exact hB
    · rw [hv0]; exact hxρ
  · have hB' : two ν ∧ (x ν).val / s = (u ν + 1) % n ν := by
      rcases hxν with h | h; exact absurd h hB; exact h
    refine key s2 x hs2_s (fun τ => ?_)
    rcases hall τ with rfl | rfl | rfl
    · rw [hv2]; simp [hμν']; exact hA
    · rw [hv2]; simp [wc, hB'.1]; exact hB'.2
    · rw [hv2]; simp [hρν]; exact hxρ
  · have hA' : two μ ∧ (x μ).val / s = (u μ + 1) % n μ := by
      rcases hxμ with h | h; exact absurd h hA; exact h
    refine key s1 x hs1_s (fun τ => ?_)
    rcases hall τ with rfl | rfl | rfl
    · rw [hv1]; simp [wc, hA'.1]; exact hA'.2
    · rw [hv1]; simp [hμν'.symm]; exact hB
    · rw [hv1]; simp [hρμ]; exact hxρ
  · have hA' : two μ ∧ (x μ).val / s = (u μ + 1) % n μ := by
      rcases hxμ with h | h; exact absurd h hA; exact h
    have hB' : two ν ∧ (x ν).val / s = (u ν + 1) % n ν := by
      rcases hxν with h | h; exact absurd h hB; exact h
    refine key s3 x hs3_s (fun τ => ?_)
    rcases hall τ with rfl | rfl | rfl
    · rw [hv3]; simp [wc, hA'.1, hμν']; exact hA'.2
    · rw [hv3]; simp [wc, hB'.1]; exact hB'.2
    · rw [hv3]; simp [hρν, hρμ]; exact hxρ

theorem cellbox_wrapΦ {ell M R k : ℕ} {Φ : Set ℕ} {S : Tower L} (s : ℕ) (hs : 2 ≤ s)
    (hadm : Admissible ell M R k S) (hcov : CoversOmΦ ell M Φ k S)
    (n u : Fin 3 → ℕ) (hn : ∀ τ, L τ + 1 = s * n τ) (hu : ∀ τ, u τ < n τ)
    (two : Fin 3 → Prop) [DecidablePred two] (hfree : ∃ ρ, ¬ two ρ)
    {Om : Set (PeriodicLatticeSite L)} (hOm0 : Om ⊆ S.Om 0)
    (hΩ : ∀ x ∈ CellReg s n u two, x ∈ Om)
    (hWidx : ∀ (sites : Set (PeriodicLatticeSite L)) (i : ℕ), IsClassCubeΦ ell M Φ k S sites i →
      (∃ y ∈ sites, y ∈ CellReg s n u two) → s ∣ bigSide M ell i) :
    ∃ (sites : Set (PeriodicLatticeSite L)) (i : ℕ), IsClassCubeΦ ell M Φ k S sites i ∧
      CellReg s n u two ⊆ sites := by
  obtain ⟨ρ, hρ⟩ := hfree
  fin_cases ρ
  · exact cellbox_coreΦ s hs hadm hcov n u hn hu two 1 2 0 (by decide) (by decide) (by decide)
      (by intro τ; fin_cases τ <;> simp) hρ hOm0 hΩ hWidx
  · exact cellbox_coreΦ s hs hadm hcov n u hn hu two 0 2 1 (by decide) (by decide) (by decide)
      (by intro τ; fin_cases τ <;> simp) hρ hOm0 hΩ hWidx
  · exact cellbox_coreΦ s hs hadm hcov n u hn hu two 0 1 2 (by decide) (by decide) (by decide)
      (by intro τ; fin_cases τ <;> simp) hρ hOm0 hΩ hWidx

end MXP.CoverGeom

